{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/index.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/about.php",
      "destination": "/api/about.php"
    },
    {
      "source": "/services.php",
      "destination": "/api/services.php"
    },
    {
      "source": "/contact.php",
      "destination": "/api/contact.php"
    }
  ]
}
